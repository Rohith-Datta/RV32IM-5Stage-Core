            12'd601: get_zbb_c_trace_char = 8'h3D; // '='
            12'd602: get_zbb_c_trace_char = 8'h0D; // '\r'
            12'd603: get_zbb_c_trace_char = 8'h0A; // '\n'
            12'd604: get_zbb_c_trace_char = 8'h0D; // '\r'
            12'd605: get_zbb_c_trace_char = 8'h0A; // '\n'
            default: get_zbb_c_trace_char = 8'h00;
        endcase
    end
endfunction
